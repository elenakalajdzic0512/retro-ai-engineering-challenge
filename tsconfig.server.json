{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "rootDir": "server",
    "outDir": "dist-server",
    "noEmitOnError": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist-server", "src", "tests"]
}
